# For running without Docker. Docker Compose sets these itself. Never commit a real .env.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ops
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Used by `pytest`. This database is wiped by the tests.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ops_test
